# Copy to backend/.env and fill in. Never commit the real file.

# Postgres + pgvector (docker compose publishes DB_PORT; keep the two in sync).
DATABASE_URL=postgresql+asyncpg://matcher:matcher@localhost:5433/matcher

# Claude (Sonnet 5.5 for conversation + extraction, Opus 5.5 for recommendations).
ANTHROPIC_API_KEY=
# live: call the API | record: call it and save cassettes | replay: cassettes only ($0)
LLM_MODE=live

# Deepgram (nova-3 live STT, Aura-2 TTS). Leave empty to run text-only.
DEEPGRAM_API_KEY=
# auto: Deepgram when the key is set | fake: scripted STT + tone TTS (no key) | off
VOICE_PROVIDER=auto
VOICE_BARGE_IN=true
VOICE_BACKCHANNEL=true

CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
LOG_PII=false
